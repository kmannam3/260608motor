{
  "entities": {
    "Consultation": {
      "title": "Consultation",
      "description": "Information submitted by users wishing to request a consultation or custom motor design guide.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique ID of the request"
        },
        "name": {
          "type": "string",
          "description": "Name of the applicant"
        },
        "contact": {
          "type": "string",
          "description": "Contact info (phone number or email)"
        },
        "specs": {
          "type": "string",
          "description": "Technical specifications needed (e.g. voltage, horsepower)"
        },
        "consent": {
          "type": "boolean",
          "description": "Whether the applicant consented to personal information collection"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The server-side timestamp showing when the request was made"
        },
        "status": {
          "type": "string",
          "description": "Processing status of the consultation (pending, completed)",
          "enum": ["pending", "completed"]
        },
        "notes": {
          "type": "string",
          "description": "Internal administrative remarks added by the motor client"
        }
      },
      "required": ["name", "contact", "specs", "consent", "createdAt", "status"]
    },
    "User": {
      "title": "User",
      "description": "User profiles registered in the system.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The firebase auth unique UID of the user"
        },
        "email": {
          "type": "string",
          "description": "Registration email address"
        },
        "displayName": {
          "type": "string",
          "description": "User display name"
        },
        "status": {
          "type": "string",
          "description": "User account status (active, suspended)",
          "enum": ["active", "suspended"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Registration timestamp"
        }
      },
      "required": ["uid", "email", "displayName", "status", "createdAt"]
    },
    "Post": {
      "title": "Post",
      "description": "Board posting or notice content generated by administrators.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique ID of the post"
        },
        "title": {
          "type": "string",
          "description": "Post title"
        },
        "content": {
          "type": "string",
          "description": "Body markdown or HTML text of the post"
        },
        "author": {
          "type": "string",
          "description": "Author user nickname or name"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["title", "content", "author", "createdAt"]
    },
    "Banner": {
      "title": "Banner",
      "description": "Promotional slide or cover banner imagery managed dynamically.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique ID of the banner entry"
        },
        "title": {
          "type": "string",
          "description": "Admin description or tag"
        },
        "imageUrl": {
          "type": "string",
          "description": "Absolute URL or base64 data uri of the banner graphic"
        },
        "linkUrl": {
          "type": "string",
          "description": "Optional address to redirect users when clicking"
        },
        "isActive": {
          "type": "boolean",
          "description": "Toggle visibility in main slider"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["title", "imageUrl", "isActive", "createdAt"]
    },
    "Popup": {
      "title": "Popup",
      "description": "Dynamic announcement dialog displayable upon initial page visit.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique ID of the popup"
        },
        "title": {
          "type": "string",
          "description": "Prompt theme or main topic"
        },
        "content": {
          "type": "string",
          "description": "Substantive message"
        },
        "imageUrl": {
          "type": "string",
          "description": "Visual decoration resource"
        },
        "isActive": {
          "type": "boolean",
          "description": "Toggle deployment activation state"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Log timestamp"
        }
      },
      "required": ["title", "content", "isActive", "createdAt"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Trusted administrative credentials UID registrar.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The UID matching a super administrator accounts"
        },
        "email": {
          "type": "string",
          "description": "Email address for validation confirmation"
        }
      },
      "required": ["uid", "email"]
    }
  },
  "firestore": {
    "/consultations/{consultationId}": {
      "schema": "Consultation",
      "description": "Stores user consultation and catalog request submissions."
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Maintains registration history index for standard users."
    },
    "/posts/{postId}": {
      "schema": "Post",
      "description": "Stores public board postings and tech bulletins."
    },
    "/banners/{bannerId}": {
      "schema": "Banner",
      "description": "Handles homepage advertising cover headers."
    },
    "/popups/{popupId}": {
      "schema": "Popup",
      "description": "Stores active campaign notices."
    },
    "/admins/{uid}": {
      "schema": "Admin",
      "description": "Privileged directory defining administrative operators."
    }
  }
}
