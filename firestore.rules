rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation helper for Consultation creation
    function isValidConsultation(data) {
      return data.keys().hasAll(['name', 'contact', 'specs', 'consent', 'createdAt'])
        && data.keys().size() == 5
        && data.name is string && data.name.size() > 0 && data.name.size() <= 128
        && data.contact is string && data.contact.size() > 0 && data.contact.size() <= 256
        && data.specs is string && data.specs.size() > 0 && data.specs.size() <= 2000
        && data.consent is bool && data.consent == true
        && data.createdAt == request.time;
    }

    // Match statement for consultations
    match /consultations/{consultationId} {
      allow create: if isValidId(consultationId) && isValidConsultation(incoming());
      allow read, update, delete: if false; // strictly secure, no client reads, public-input only
    }
  }
}
