rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Checking email for bootstrapped administrator kmannam3@gmail.com or exist in admins directory
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "kmannam3@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 2. Validation Blueprints (Anti-Update-Gaps)
    function isValidConsultation(data) {
      return data.keys().hasAll(['name', 'contact', 'specs', 'consent', 'createdAt', 'status'])
        && (data.keys().size() == 6 || data.keys().size() == 7) // allow optional notes (remark)
        && data.name is string && data.name.size() > 0 && data.name.size() <= 128
        && data.contact is string && data.contact.size() > 0 && data.contact.size() <= 256
        && data.specs is string && data.specs.size() > 0 && data.specs.size() <= 2000
        && data.consent is bool && data.consent == true
        && data.status is string && data.status in ['pending', 'completed']
        && data.createdAt == request.time;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'status', 'createdAt'])
        && data.keys().size() == 5
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128
        && data.email is string && data.email.size() > 0 && data.email.size() <= 256
        && data.displayName is string && data.displayName.size() <= 128
        && data.status is string && data.status in ['active', 'suspended']
        && data.createdAt == request.time;
    }

    function isValidPost(data) {
      return data.keys().hasAll(['title', 'content', 'author', 'createdAt'])
        && data.keys().size() == 4
        && data.title is string && data.title.size() > 0 && data.title.size() <= 256
        && data.content is string && data.content.size() > 0 && data.content.size() <= 10000
        && data.author is string && data.author.size() > 0 && data.author.size() <= 128
        && data.createdAt == request.time;
    }

    function isValidBanner(data) {
      return data.keys().hasAll(['title', 'imageUrl', 'isActive', 'createdAt'])
        && (data.keys().size() == 4 || data.keys().size() == 5) // allow optional linkUrl
        && data.title is string && data.title.size() > 0 && data.title.size() <= 128
        && data.imageUrl is string && data.imageUrl.size() > 0 && data.imageUrl.size() <= 500000 // support large strings or dataurls
        && data.isActive is bool
        && data.createdAt == request.time;
    }

    function isValidPopup(data) {
      return data.keys().hasAll(['title', 'content', 'isActive', 'createdAt'])
        && (data.keys().size() == 4 || data.keys().size() == 5) // allow optional imageUrl
        && data.title is string && data.title.size() > 0 && data.title.size() <= 256
        && data.content is string && data.content.size() > 0 && data.content.size() <= 2000
        && data.isActive is bool
        && data.createdAt == request.time;
    }

    // 3. Collection Match Blocks

    // Consultations
    match /consultations/{consultationId} {
      allow create: if isValidId(consultationId) && isValidConsultation(incoming());
      allow read, update, delete: if isAdmin();
    }

    // Registered Users Directory
    match /users/{userId} {
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow read: if isOwner(userId) || isAdmin();
      allow update: if (isOwner(userId) && incoming().status == existing().status) || isAdmin(); // Standard user cannot change active/suspended status
      allow delete: if isAdmin();
    }

    // Bulletins & Notice Board
    match /posts/{postId} {
      allow read, list: if true; // Public access
      allow create: if isAdmin() && isValidId(postId) && isValidPost(incoming());
      allow update: if isAdmin() && isValidPost(incoming());
      allow delete: if isAdmin();
    }

    // Dynamic Hero Covers & Banners
    match /banners/{bannerId} {
      allow read, list: if true; // Public access
      allow create: if isAdmin() && isValidId(bannerId) && isValidBanner(incoming());
      allow update: if isAdmin() && isValidBanner(incoming());
      allow delete: if isAdmin();
    }

    // Active Marketing Popups
    match /popups/{popupId} {
      allow read, list: if true; // Public access
      allow create: if isAdmin() && isValidId(popupId) && isValidPopup(incoming());
      allow update: if isAdmin() && isValidPopup(incoming());
      allow delete: if isAdmin();
    }

    // Privileged Admins Directory
    match /admins/{uid} {
      allow read, write: if isAdmin();
    }
  }
}
